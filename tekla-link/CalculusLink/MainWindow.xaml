<ui:FluentWindow
    x:Class="CalculusLink.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:bridge="clr-namespace:CalculusLink.Bridge"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CalculusLink"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Calculus Link"
    Width="560"
    Height="800"
    MinWidth="480"
    MinHeight="420"
    d:DataContext="{Binding}"
    ExtendsContentIntoTitleBar="True"
    MouseDown="Window_MouseDown"
    WindowBackdropType="Mica"
    mc:Ignorable="d">

    <ui:FluentWindow.Resources>

        <ResourceDictionary>
            <!--  The Tekla model in the title bar: a long name trims, the dot stays  -->
            <DataTemplate DataType="{x:Type local:TeklaConnectionStatus}">
                <DockPanel
                    VerticalAlignment="Center"
                    ToolTip="{Binding ToolTip}">
                    <Ellipse
                        Width="8"
                        Height="8"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Right"
                        Fill="{Binding ConnectionColor}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{Binding ModelName}"
                        TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </DataTemplate>
            <BooleanToVisibilityConverter
                x:Key="BoolToVisibility" />
            <bridge:SyncStateBrushConverter
                x:Key="StateBrush" />

            <!--  Tabs: text over an accent underline that sits on the strip's divider  -->
            <Style
                x:Key="TabButton"
                TargetType="RadioButton">
                <Setter Property="Padding" Value="4,6,4,8" />
                <Setter Property="Margin" Value="0,0,20,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid Background="Transparent">
                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                                <Border
                                    x:Name="Underline"
                                    Height="3"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    CornerRadius="1.5"
                                    Visibility="Hidden" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  Card header pieces, shared by both tabs  -->
            <Style
                x:Key="Badge"
                TargetType="Border">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Margin" Value="0,0,10,0" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <SolidColorBrush x:Key="ToTeklaBrush" Color="#3875e0" />
            <SolidColorBrush x:Key="ToTeklaTint" Color="#263875e0" />
            <SolidColorBrush x:Key="ToCalculusBrush" Color="#40904f" />
            <SolidColorBrush x:Key="ToCalculusTint" Color="#2640904f" />
            <SolidColorBrush x:Key="NeutralTint" Color="#268b949e" />

            <Style
                x:Key="CardFooter"
                TargetType="Border">
                <Setter Property="Margin" Value="-12,12,-12,-12" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
                <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
            </Style>

            <Style
                x:Key="FieldLabel"
                TargetType="ui:TextBlock">
                <Setter Property="Width" Value="84" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Appearance" Value="Secondary" />
            </Style>

            <local:InverseBoolToVisibilityConverter
                x:Key="InverseBoolToVisibility" />

            <!--  Preview: what Apply would write, one row per object, the dot in the models' colour  -->
            <Style
                x:Key="PreviewPanel"
                TargetType="Border">
                <Setter Property="Margin" Value="0,10,0,0" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <DataTemplate
                x:Key="PreviewTable"
                DataType="{x:Type local:TransferDirectionViewModel}">
                <Border Style="{StaticResource PreviewPanel}">
                    <StackPanel>
                        <ui:TextBlock
                            Text="{Binding PreviewText}"
                            TextWrapping="Wrap" />

                        <!--  Act on the selected rows; Space does the same in the table  -->
                        <StackPanel
                            Margin="0,8,0,0"
                            Orientation="Horizontal">
                            <ui:Button
                                Padding="8,4"
                                Command="{Binding ViewModel.IncludeSelectedCommand, RelativeSource={RelativeSource AncestorType=local:MainWindow}}"
                                CommandParameter="{Binding}"
                                Content="Include"
                                Icon="{ui:SymbolIcon Checkmark16}"
                                IsEnabled="{Binding HasSelectedRows}"
                                ToolTip="Transfer the selected rows" />
                            <ui:Button
                                Margin="6,0,0,0"
                                Padding="8,4"
                                Command="{Binding ViewModel.ExcludeSelectedCommand, RelativeSource={RelativeSource AncestorType=local:MainWindow}}"
                                CommandParameter="{Binding}"
                                Content="Leave out"
                                Icon="{ui:SymbolIcon Dismiss16}"
                                IsEnabled="{Binding HasSelectedRows}"
                                ToolTip="Leave the selected rows out of this transfer. A new part takes its new bolts and welds with it." />
                            <ui:TextBlock
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Appearance="Tertiary"
                                Text="Selecting rows selects the objects in both models" />
                        </StackPanel>

                        <ui:DataGrid
                            Margin="0,8,0,0"
                            MaxHeight="280"
                            AutoGenerateColumns="False"
                            Background="Transparent"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            CanUserReorderColumns="False"
                            CanUserResizeRows="False"
                            CanUserSortColumns="True"
                            EnableRowVirtualization="True"
                            GridLinesVisibility="None"
                            HeadersVisibility="Column"
                            IsReadOnly="True"
                            ItemsSource="{Binding Rows}"
                            PreviewKeyDown="PreviewGrid_PreviewKeyDown"
                            SelectionChanged="PreviewGrid_SelectionChanged"
                            SelectionMode="Extended"
                            SelectionUnit="FullRow"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            VirtualizingPanel.VirtualizationMode="Recycling">
                            <ui:DataGrid.Columns>
                                <DataGridTemplateColumn
                                    Width="44"
                                    CanUserResize="False"
                                    SortMemberPath="Include">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <!--  WPF-UI's check box keeps a 32 px minimum height and content padding: both clip in a grid cell  -->
                                            <CheckBox
                                                MinWidth="0"
                                                MinHeight="0"
                                                Margin="0"
                                                Padding="0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsChecked="{Binding Include, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                ToolTip="Include in the transfer" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn
                                    Width="96"
                                    Header="State"
                                    SortMemberPath="State">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                                <Ellipse
                                                    Width="8"
                                                    Height="8"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Fill="{Binding State, Converter={StaticResource StateBrush}}" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Text="{Binding State}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn
                                    Width="80"
                                    Binding="{Binding Type}"
                                    Header="Type" />
                                <DataGridTextColumn
                                    Width="*"
                                    MinWidth="60"
                                    Binding="{Binding Name}"
                                    Header="Name" />
                                <DataGridTextColumn
                                    Width="*"
                                    MinWidth="60"
                                    Binding="{Binding Profile}"
                                    Header="Profile" />
                            </ui:DataGrid.Columns>
                        </ui:DataGrid>

                        <!--  Decide: nothing is written until Apply  -->
                        <StackPanel
                            Margin="0,10,0,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <ui:Button
                                Command="{Binding ViewModel.CancelPreviewCommand, RelativeSource={RelativeSource AncestorType=local:MainWindow}}"
                                CommandParameter="{Binding}"
                                Content="Cancel"
                                ToolTip="Close the preview; nothing is written" />
                            <ui:Button
                                MinWidth="120"
                                Margin="8,0,0,0"
                                Appearance="Primary"
                                Command="{Binding ViewModel.ApplyCommand, RelativeSource={RelativeSource AncestorType=local:MainWindow}}"
                                CommandParameter="{Binding}"
                                Content="{Binding ApplyText}"
                                Icon="{ui:SymbolIcon Checkmark20}"
                                ToolTip="Write the checked rows. If either model changed since the preview, nothing is written and the preview is refreshed." />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>

    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="*" />
        </Grid.RowDefinitions>

        <!--  Title bar  -->
        <ui:TitleBar
            Grid.Row="0"
            ShowMaximize="False"
            ShowMinimize="True">
            <ui:TitleBar.Header>
                <StackPanel
                    Margin="8,8,0,0"
                    Orientation="Horizontal">
                    <Image
                        Width="16"
                        Height="16"
                        VerticalAlignment="Top"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Source="pack://application:,,,/AppIcon.ico" />
                    <ui:TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Top"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="Calculus Link" />
                </StackPanel>
            </ui:TitleBar.Header>
            <ui:TitleBar.TrailingContent>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="*" />
                        <ColumnDefinition
                            Width="Auto" />
                        <ColumnDefinition
                            Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentControl
                        Grid.Column="0"
                        Height="30"
                        Margin="16,0,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Content="{Binding ConnectionStatus}"
                        IsTabStop="False" />
                    <ui:Button
                        Grid.Column="1"
                        Height="30"
                        CornerRadius="0"
                        VerticalAlignment="Top"
                        Appearance="Transparent"
                        BorderThickness="0"
                        ToolTipService.ToolTip="Click to check updates"
                        Click="UpdateButton_Click">
                        <ui:TextBlock
                            Text="{Binding ViewModel.AppVersion, Mode=OneWay}" />
                    </ui:Button>
                    <ui:Button
                        Grid.Column="2"
                        x:Name="TopMostButton"
                        Width="44"
                        Height="30"
                        VerticalAlignment="Top"
                        Appearance="Transparent"
                        BorderThickness="0"
                        Click="TopMostButton_Click"
                        CornerRadius="0"
                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                        Icon="{ui:SymbolIcon Pin20,
                                             Filled=True}" />
                </Grid>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!--  Tab strip: the tabs sit on a full-width divider  -->
        <Grid
            Grid.Row="1"
            Margin="12,0,12,0">
            <Border
                Height="1"
                VerticalAlignment="Bottom"
                Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <StackPanel Orientation="Horizontal">
                <RadioButton
                    Content="Direct transfer"
                    GroupName="TransferMode"
                    IsChecked="{Binding ViewModel.ShowDirectTransfer, Mode=TwoWay}"
                    Style="{StaticResource TabButton}" />
                <RadioButton
                    Content="File transfer"
                    GroupName="TransferMode"
                    IsChecked="{Binding ViewModel.ShowFileTransfer, Mode=TwoWay}"
                    Style="{StaticResource TabButton}" />
            </StackPanel>
        </Grid>

        <!--  File transfer: the same card column as Direct transfer  -->
        <ScrollViewer
            Grid.Row="2"
            Padding="12"
            VerticalScrollBarVisibility="Auto"
            Visibility="{Binding ViewModel.ShowFileTransfer, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>

                <!--  Tekla selection -> .calculus file  -->
                <ui:Card
                    Padding="12"
                    VerticalContentAlignment="Top">
                    <StackPanel>
                        <DockPanel>
                            <Border
                                Background="{StaticResource ToCalculusTint}"
                                Style="{StaticResource Badge}">
                                <ui:SymbolIcon
                                    FontSize="18"
                                    Foreground="{StaticResource ToCalculusBrush}"
                                    Symbol="ArrowUpload20" />
                            </Border>
                            <StackPanel>
                                <ui:TextBlock
                                    FontTypography="BodyStrong"
                                    Text="Tekla → Calculus" />
                                <ui:TextBlock
                                    Margin="0,2,0,0"
                                    Appearance="Secondary"
                                    Text="Save Tekla objects as a .calculus file."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                        <StackPanel
                            Margin="42,10,0,0"
                            Orientation="Horizontal">
                            <ui:TextBlock
                                Style="{StaticResource FieldLabel}"
                                Text="Objects"
                                ToolTip="Selected: the objects selected in Tekla — a component stands for the parts, bolts and welds it made. Whole model: every transferable object in the Tekla model." />
                            <ComboBox
                                Width="140"
                                DisplayMemberPath="Label"
                                ItemsSource="{Binding ViewModel.ScopeOptions}"
                                SelectedValue="{Binding ViewModel.ExportScope}"
                                SelectedValuePath="Value" />
                        </StackPanel>
                        <StackPanel
                            Margin="42,6,0,0"
                            Orientation="Horizontal">
                            <ui:TextBlock
                                Style="{StaticResource FieldLabel}"
                                Text="Location by"
                                ToolTip="Coordinate system with respect to which the object positions will be defined in the .calculus file" />
                            <ComboBox
                                Width="140"
                                ItemsSource="{Binding ViewModel.CoordinateSystemOptions}"
                                SelectedItem="{Binding ViewModel.ExportCoordinateSystem}" />
                        </StackPanel>
                        <Border Style="{StaticResource CardFooter}">
                            <DockPanel LastChildFill="False">
                                <ui:Button
                                    MinWidth="120"
                                    Appearance="Primary"
                                    Click="ExportButton_Click"
                                    DockPanel.Dock="Right">
                                    <ContentControl>
                                        <ContentControl.Style>
                                            <Style TargetType="{x:Type ContentControl}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Path=ViewModel.IsExporting}" Value="False">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <ui:SymbolIcon
                                                                            Margin="0,0,6,0"
                                                                            Symbol="ArrowDownload20" />
                                                                        <TextBlock Text="Create file…" />
                                                                    </StackPanel>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Path=ViewModel.IsExporting}" Value="True">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <ui:ProgressRing
                                                                            Width="16"
                                                                            Height="16"
                                                                            Margin="0,0,6,0"
                                                                            IsIndeterminate="True" />
                                                                        <TextBlock Text="Exporting…" />
                                                                    </StackPanel>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                    </ContentControl>
                                </ui:Button>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ui:Card>

                <!--  .calculus file -> Tekla; the whole card takes a dropped file  -->
                <ui:Card
                    Margin="0,8,0,0"
                    Padding="12"
                    VerticalContentAlignment="Top"
                    AllowDrop="True"
                    Drop="ImportGrid_Drop">
                    <StackPanel>
                        <DockPanel>
                            <Border
                                Background="{StaticResource ToTeklaTint}"
                                Style="{StaticResource Badge}">
                                <ui:SymbolIcon
                                    FontSize="18"
                                    Foreground="{StaticResource ToTeklaBrush}"
                                    Symbol="ArrowDownload20" />
                            </Border>
                            <StackPanel>
                                <ui:TextBlock
                                    FontTypography="BodyStrong"
                                    Text="Calculus → Tekla" />
                                <ui:TextBlock
                                    Margin="0,2,0,0"
                                    Appearance="Secondary"
                                    Text="Insert the objects of a .calculus file into the Tekla model."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                        <StackPanel
                            Margin="42,10,0,0"
                            Orientation="Horizontal">
                            <ui:TextBlock
                                Style="{StaticResource FieldLabel}"
                                Text="Location by"
                                ToolTip="Coordinate system with respect to which new objects in Tekla will be placed" />
                            <ComboBox
                                Width="140"
                                ItemsSource="{Binding ViewModel.CoordinateSystemOptions}"
                                SelectedItem="{Binding ViewModel.ImportCoordinateSystem}" />
                        </StackPanel>
                        <Border Style="{StaticResource CardFooter}">
                            <DockPanel>
                                <ui:Button
                                    MinWidth="120"
                                    Appearance="Primary"
                                    Click="ImportButton_Click"
                                    DockPanel.Dock="Right">
                                    <ContentControl>
                                        <ContentControl.Style>
                                            <Style TargetType="{x:Type ContentControl}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Path=ViewModel.IsImporting}" Value="False">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <ui:SymbolIcon
                                                                            Margin="0,0,6,0"
                                                                            Symbol="Document20" />
                                                                        <TextBlock Text="Select file…" />
                                                                    </StackPanel>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Path=ViewModel.IsImporting}" Value="True">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <ui:ProgressRing
                                                                            Width="16"
                                                                            Height="16"
                                                                            Margin="0,0,6,0"
                                                                            IsIndeterminate="True" />
                                                                        <TextBlock Text="Importing…" />
                                                                    </StackPanel>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                    </ContentControl>
                                </ui:Button>
                                <ui:TextBlock
                                    VerticalAlignment="Center"
                                    Appearance="Tertiary"
                                    Text="or drop a .calculus file on this card"
                                    TextWrapping="Wrap" />
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>

        <!--  Direct transfer  -->
        <ScrollViewer
            Grid.Row="2"
            Padding="12"
            VerticalScrollBarVisibility="Auto"
            Visibility="{Binding ViewModel.ShowDirectTransfer, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>

                <!--  Connection: status first; refreshes on its own, the button is the fallback  -->
                <ui:Card
                    Padding="12"
                    VerticalContentAlignment="Top">
                    <StackPanel>
                        <DockPanel>
                            <Border
                                Background="{StaticResource NeutralTint}"
                                Style="{StaticResource Badge}">
                                <ui:SymbolIcon
                                    FontSize="18"
                                    Symbol="PlugConnected20" />
                            </Border>
                            <ToggleButton
                                x:Name="ConnectionSettingsToggle"
                                IsChecked="{Binding ViewModel.ShowConnectionSettings, Mode=TwoWay}"
                                Margin="6,0,0,0"
                                Padding="7"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Right"
                                ToolTip="Port and token">
                                <ui:SymbolIcon Symbol="Settings20" />
                            </ToggleButton>
                            <ui:Button
                                Margin="6,0,0,0"
                                Padding="7"
                                VerticalAlignment="Center"
                                Command="{Binding ViewModel.RefreshCommand}"
                                DockPanel.Dock="Right"
                                Icon="{ui:SymbolIcon ArrowClockwise20}"
                                ToolTip="Look for Calculus and its open models again" />
                            <StackPanel Margin="0,0,12,0">
                                <ui:TextBlock
                                    FontTypography="BodyStrong"
                                    Text="Calculus desktop app" />
                                <StackPanel
                                    Margin="0,2,0,0"
                                    Orientation="Horizontal">
                                    <Ellipse
                                        Width="8"
                                        Height="8"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#8b949e" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ViewModel.EditorConnected}" Value="True">
                                                        <Setter Property="Fill" Value="#3fb950" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <ui:TextBlock
                                        Appearance="Secondary"
                                        Text="{Binding ViewModel.BridgeStatusText}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding ViewModel.BridgeStatusText}" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                        <StackPanel
                            Margin="42,10,0,0"
                            Orientation="Horizontal"
                            Visibility="{Binding ViewModel.HasSeveralEditors, Converter={StaticResource BoolToVisibility}}">
                            <ui:TextBlock
                                Style="{StaticResource FieldLabel}"
                                Text="Model" />
                            <ComboBox
                                MinWidth="220"
                                ItemsSource="{Binding ViewModel.Editors}"
                                SelectedItem="{Binding ViewModel.SelectedEditor, Mode=TwoWay}"
                                ToolTip="Several models are open in Calculus: pick the one transfers go to" />
                        </StackPanel>
                        <StackPanel
                            Margin="42,0,0,0"
                            Visibility="{Binding IsChecked, ElementName=ConnectionSettingsToggle, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:TextBlock
                                        Style="{StaticResource FieldLabel}"
                                        Text="Port" />
                                    <ui:TextBox
                                        Width="96"
                                        Text="{Binding ViewModel.BridgePort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <DockPanel Margin="0,8,0,0">
                                    <ui:TextBlock
                                        Style="{StaticResource FieldLabel}"
                                        Text="Token" />
                                    <ui:TextBox
                                        PlaceholderText="Only if the app requires one"
                                        Text="{Binding ViewModel.BridgeToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <!--  Tekla → Calculus  -->
                <ui:Card
                    Margin="0,8,0,0"
                    Padding="12"
                    VerticalContentAlignment="Top">
                    <StackPanel>
                        <DockPanel>
                            <Border
                                Background="{StaticResource ToCalculusTint}"
                                Style="{StaticResource Badge}">
                                <ui:SymbolIcon
                                    FontSize="18"
                                    Foreground="{StaticResource ToCalculusBrush}"
                                    Symbol="ArrowUpload20" />
                            </Border>
                            <StackPanel>
                                <ui:TextBlock
                                    FontTypography="BodyStrong"
                                    Text="Tekla → Calculus" />
                                <ui:TextBlock
                                    Margin="0,2,0,0"
                                    Appearance="Secondary"
                                    Text="Preview what sending the Tekla objects would do, then apply it. Changed twins are updated, unchanged ones skipped."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                        <StackPanel Margin="42,10,0,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock
                                    Style="{StaticResource FieldLabel}"
                                    Text="Objects"
                                    ToolTip="Selected: the objects selected in Tekla — a component stands for the parts, bolts and welds it made. Whole model: every transferable object in the Tekla model." />
                                <ComboBox
                                    Width="140"
                                    DisplayMemberPath="Label"
                                    ItemsSource="{Binding ViewModel.ScopeOptions}"
                                    SelectedValue="{Binding ViewModel.ToCalculus.Scope}"
                                    SelectedValuePath="Value" />
                            </StackPanel>
                            <StackPanel
                                Margin="0,6,0,0"
                                Orientation="Horizontal">
                                <ui:TextBlock
                                    Style="{StaticResource FieldLabel}"
                                    Text="Location by"
                                    ToolTip="Coordinate system in which object positions are defined in Calculus" />
                                <ComboBox
                                    Width="140"
                                    ItemsSource="{Binding ViewModel.CoordinateSystemOptions}"
                                    SelectedItem="{Binding ViewModel.ToCalculus.CoordinateSystem}" />
                            </StackPanel>
                            <CheckBox
                                Margin="-11,6,0,0"
                                Content="Overwrite conflicts"
                                IsChecked="{Binding ViewModel.ToCalculus.OverwriteConflicts, Mode=TwoWay}"
                                ToolTip="Check conflicting rows by default: a twin that also changed in Calculus since the last transfer. Applying them loses the Calculus changes." />
                            <CheckBox
                                Margin="-11,0,0,0"
                                Content="Remove objects deleted in Tekla"
                                IsChecked="{Binding ViewModel.ToCalculus.RemoveGone, Mode=TwoWay}"
                                ToolTip="Check gone rows by default: Calculus objects whose Tekla twin no longer exists." />
                        </StackPanel>

                        <ContentControl
                            Content="{Binding ViewModel.ToCalculus}"
                            ContentTemplate="{StaticResource PreviewTable}"
                            Focusable="False"
                            Visibility="{Binding ViewModel.ToCalculus.HasPreview, Converter={StaticResource BoolToVisibility}}" />

                        <Border
                            Style="{StaticResource CardFooter}"
                            Visibility="{Binding ViewModel.ToCalculus.HasPreview, Converter={StaticResource InverseBoolToVisibility}}">
                            <ui:Button
                                MinWidth="120"
                                HorizontalAlignment="Right"
                                Appearance="Primary"
                                Command="{Binding ViewModel.PreviewCommand}"
                                CommandParameter="{Binding ViewModel.ToCalculus}"
                                Content="Preview…"
                                Icon="{ui:SymbolIcon Eye20}"
                                ToolTip="Show what the transfer would do, in both models and as a list. Nothing is written until you apply it." />
                        </Border>
                    </StackPanel>
                </ui:Card>

                <!--  Calculus → Tekla  -->
                <ui:Card
                    Margin="0,8,0,0"
                    Padding="12"
                    VerticalContentAlignment="Top">
                    <StackPanel>
                        <DockPanel>
                            <Border
                                Background="{StaticResource ToTeklaTint}"
                                Style="{StaticResource Badge}">
                                <ui:SymbolIcon
                                    FontSize="18"
                                    Foreground="{StaticResource ToTeklaBrush}"
                                    Symbol="ArrowDownload20" />
                            </Border>
                            <StackPanel>
                                <ui:TextBlock
                                    FontTypography="BodyStrong"
                                    Text="Calculus → Tekla" />
                                <ui:TextBlock
                                    Margin="0,2,0,0"
                                    Appearance="Secondary"
                                    Text="Preview what sending the Calculus objects would do, then apply it. Changed twins are updated, unchanged ones skipped."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                        <StackPanel Margin="42,10,0,0">
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBlock
                                    Style="{StaticResource FieldLabel}"
                                    Text="Objects"
                                    ToolTip="Selected: the objects selected in Calculus — a component stands for its child objects. Whole model: every transferable object in the Calculus model." />
                                <ComboBox
                                    Width="140"
                                    DisplayMemberPath="Label"
                                    ItemsSource="{Binding ViewModel.ScopeOptions}"
                                    SelectedValue="{Binding ViewModel.ToTekla.Scope}"
                                    SelectedValuePath="Value" />
                            </StackPanel>
                            <StackPanel
                                Margin="0,6,0,0"
                                Orientation="Horizontal">
                                <ui:TextBlock
                                    Style="{StaticResource FieldLabel}"
                                    Text="Location by"
                                    ToolTip="Coordinate system with respect to which new objects are placed in Tekla" />
                                <ComboBox
                                    Width="140"
                                    ItemsSource="{Binding ViewModel.CoordinateSystemOptions}"
                                    SelectedItem="{Binding ViewModel.ToTekla.CoordinateSystem}" />
                            </StackPanel>
                            <CheckBox
                                Margin="-11,6,0,0"
                                Content="Overwrite conflicts"
                                IsChecked="{Binding ViewModel.ToTekla.OverwriteConflicts, Mode=TwoWay}"
                                ToolTip="Check conflicting rows by default: a twin that also changed in Tekla since the last transfer. Applying them loses the Tekla changes." />
                            <CheckBox
                                Margin="-11,0,0,0"
                                Content="Remove objects deleted in Calculus"
                                IsChecked="{Binding ViewModel.ToTekla.RemoveGone, Mode=TwoWay}"
                                ToolTip="Check gone rows by default: Tekla objects whose Calculus twin no longer exists — among the Tekla selection, or the whole Tekla model when the scope is Whole model." />
                        </StackPanel>

                        <ContentControl
                            Content="{Binding ViewModel.ToTekla}"
                            ContentTemplate="{StaticResource PreviewTable}"
                            Focusable="False"
                            Visibility="{Binding ViewModel.ToTekla.HasPreview, Converter={StaticResource BoolToVisibility}}" />

                        <Border
                            Style="{StaticResource CardFooter}"
                            Visibility="{Binding ViewModel.ToTekla.HasPreview, Converter={StaticResource InverseBoolToVisibility}}">
                            <ui:Button
                                MinWidth="120"
                                HorizontalAlignment="Right"
                                Appearance="Primary"
                                Command="{Binding ViewModel.PreviewCommand}"
                                CommandParameter="{Binding ViewModel.ToTekla}"
                                Content="Preview…"
                                Icon="{ui:SymbolIcon Eye20}"
                                ToolTip="Show what the transfer would do, in both models and as a list. Nothing is written until you apply it." />
                        </Border>
                    </StackPanel>
                </ui:Card>

                <!--  Transfer progress  -->
                <StackPanel
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Visibility="{Binding ViewModel.IsTransferring, Converter={StaticResource BoolToVisibility}}">
                    <ui:ProgressRing
                        Width="16"
                        Height="16"
                        Margin="0,0,8,0"
                        IsIndeterminate="True" />
                    <ui:TextBlock
                        VerticalAlignment="Center"
                        Appearance="Secondary"
                        Text="Transferring…" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>


        <ui:SnackbarPresenter
            x:Name="SnackbarPresenter"
            Grid.Row="2"
            HorizontalAlignment="Center" />
    </Grid>
</ui:FluentWindow>
