<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
    <PublishRelease>true</PublishRelease>
    <Version>1.3.0.0</Version>
    <TeklaVersion Condition="'$(Configuration)' == 'Debug'">2025.0</TeklaVersion>
    <AssemblyTitle>Calculus Link for Tekla Structures</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Tekla.Structures.Model" ExcludeAssets="runtime" />
    <PackageReference Include="Tekla.Structures.Catalogs" ExcludeAssets="runtime" />
    <PackageReference Include="TeklaAPIExtensions.Model" />
    <PackageReference Include="TSAppConfigPatcherTask" />
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CalculusModel\CalculusModel.csproj" />
  </ItemGroup>

  <!-- The window's title-bar icon (MainWindow.xaml) reads the same .ico. -->
  <ItemGroup>
    <Resource Include="AppIcon.ico" />
  </ItemGroup>

  <!-- Hub client uses System.Net.Http (framework assembly on net48). -->
  <ItemGroup>
    <Reference Include="System.Net.Http" />
  </ItemGroup>

</Project>
