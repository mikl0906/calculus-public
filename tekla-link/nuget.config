<?xml version="1.0" encoding="utf-8"?>
<!-- Every package comes from nuget.org. One source keeps central package
     management reproducible (NU1507) and the build free of user feeds. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
